@startuml
title Fluxo de Atividade - Monitor altera status de computador

note right of "Monitor"
  Supervisor da Biblioteca
  também executa este fluxo.
end note

|Monitor|
start
:Acessa painel de acompanhamento da sala;

|Sistema|
:Carrega sessoes ativas;
:Carrega computadores cadastrados;
:Exibe computadores disponiveis, ocupados e indisponiveis;

|Monitor|
:Seleciona um computador;
:Solicita alteracao de status;

|Sistema|
:Exibe status atual e opcoes permitidas;

|Monitor|
:Seleciona novo status;
:Informa justificativa, se necessario;
:Confirma alteracao;

|Sistema|
if (Alteracao permitida?) then (Sim)
  if (Sai de AVAILABLE?) then (Sim)
    :Reconcilia prazos e bloqueia recursos;
    if (Sessao ativa?) then (Sim)
      :Busca computador para o tempo restante;
      if (Encontrou substituto?) then (Sim)
        :Transfere a mesma sessao;
      else (Nao)
        :Encerra sessao com\nCOMPUTER_UNAVAILABLE;
      endif
    endif
    while (Existe reserva confirmada?) is (Sim)
      :Busca computador para todo o intervalo;
      if (Encontrou substituto?) then (Sim)
        :Realoca reserva e audita;
      else (Nao)
        :Cancela reserva com motivo;
      endif
    endwhile (Nao)
  endif
  :Atualiza status do computador;
  :Registra historico e auditoria;
  :Atualiza painel da sala;
  :Exibe confirmacao e resumo do impacto;
  stop
else (Nao)
  :Informa motivo da rejeicao;
  stop
endif

@enduml

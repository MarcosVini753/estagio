@startuml
title Fluxo de Atividade - Registrar entrada na Sala de Informatica

|Usuario da Sala|
start
:Acessa a opcao "Registrar entrada";
:Informa ou confirma seus dados;
:Seleciona computador desejado;
:Informa reserva ou escolhe quantidade de slots;

|Sistema|
:Reconcilia prazos no computador e nas reservas do usuario;
:Verifica se o usuario ja possui sessao ativa;

if (Usuario ja possui sessao ativa?) then (Sim)
  :Informa que ja existe uma sessao em aberto;
  stop
else (Nao)
  if (Entrada vinculada a reserva?) then (Sim)
    :Valida entrada de tres minutos antes do inicio ate o prazo de check-in;
    if (Dentro da janela de check-in?) then (Sim)
      :Copia intervalo planejado e prazo da reserva;
      :Marca reserva como utilizada;
    else (Nao)
      :Rejeita entrada;
      stop
    endif
  else (Nao)
    :Valida fim escolhido na grade fixa posterior a agora;
    :Valida fechamento, reservas do computador e do usuario;
  endif

  :Verifica status e sessoes planejadas do computador;
  if (Intervalo disponivel?) then (Sim)
    :Registra horario real de entrada;
    :Cria sessao com intervalo planejado e prazo de saida;
    :Cria primeira alocacao do computador;
    :Exibe fim planejado;
    stop
  else (Nao)
    :Informa conflito no intervalo solicitado;
    stop
  endif
endif

@enduml

@startuml
title Fluxo de Atividade - Registrar saida da Sala de Informatica

|Usuario da Sala|
start
:Acessa a opcao "Registrar saida";

|Sistema|
:Busca sessao ativa do usuario;

if (Existe sessao ativa?) then (Sim)
  :Exibe dados da sessao;
  :Exibe computador, fim planejado e prazo de saida;

  |Usuario da Sala|
  :Confirma encerramento do uso;

  |Sistema|
  if (Prazo de saida ultrapassado?) then (Sim)
    :Registra automaticamente a saida e encerra no prazo;
    :Marca alocacao como TIME_LIMIT_REACHED;
  else (Nao)
    :Registra horario real da saida antecipada ou no prazo;
    :Encerra alocacao atual e sessao;
  endif
  :Exibe confirmacao de saida e tempo real;
  stop

else (Nao)
  :Informa que nao ha sessao ativa para encerrar;
  stop
endif

@enduml

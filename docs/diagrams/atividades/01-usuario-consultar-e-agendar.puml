@startuml
title Fluxo de Atividade - Consultar disponibilidade e agendar computador

|Usuario da Sala|
start
:Acessa a area de computadores;
:Escolhe consultar dia atual ou dia seguinte;

|Sistema|
:Resolve excecao, horario temporario ou regular;
if (Sala fechada?) then (Sim)
  :Exibe motivo, janelas vazias e avisos ativos;
  stop
else (Nao)
  :Exibe origem, janelas e avisos ativos;
endif
:Carrega computadores cadastrados;
:Verifica status dos computadores;
:Verifica horarios ocupados e agendados;
:Exibe computadores e horarios disponiveis;

|Usuario da Sala|
if (Deseja agendar?) then (Sim)
  :Seleciona computador;
  :Seleciona inicio alinhado;
  :Seleciona quantidade de slots consecutivos;

  |Sistema|
  :Valida se a data e hoje ou amanha;
  if (Data valida?) then (Sim)
    :Calcula fim por slot_count x 15 minutos;
    :Valida todo o intervalo na mesma janela operacional;
    :Verifica reservas e sessoes planejadas do computador e usuario;
    if (Intervalo ainda disponivel?) then (Sim)
      :Registra reserva e deadlines de tres minutos;
      :Exibe confirmacao;
      stop
    else (Nao)
      :Informa que o intervalo ficou indisponivel;
      :Retorna a consulta de horarios;
      stop
    endif
   else (Nao)
     :Informa que agendamento e permitido apenas para hoje ou amanha;
     stop
   endif

else (Nao)
  :Encerra consulta;
  stop
endif

@enduml
